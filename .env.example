# Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=your-gemini-key
# Optional: primary model first, then fallbacks for rate limits / outages
# GEMINI_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Telegram (@BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=123456789:AA...
# Optional: separate manager chat id. Empty = single-account demo mode (same chat)
MANAGER_CHAT_ID=

# Gmail SMTP (myaccount.google.com/apppasswords)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
# Optional: where decision emails go (default: GMAIL_ADDRESS)
NOTIFY_EMAIL=
EMAIL_ENABLED=true
